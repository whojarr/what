# OpenAI API key (required for idea interpretation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Local development ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://127.0.0.1:8000

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=change-me-in-production

CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

AUTO_APPROVE_CAPABILITIES=false
CAPABILITIES_PATH=data/capabilities.yaml
SAVES_PATH=data/saves

# --- AWS Lambda (set before: yarn deploy) ---
# SAVES_PATH=/tmp/civsim/saves  (set in serverless.yml)
# FASTAPI_BASE_URL is injected for the web function from API Gateway
# AWS credentials: aws configure / AWS_PROFILE
